#!/bin/sh
# @PACKAGE@ prerm: stop units, remove only the /etc copies that still match this package.
set -e

UNITS="@UNITS@"
for unit in $UNITS; do
  systemctl stop "$unit" 2>/dev/null || true
done

root_was_read_only=0
restore_root_read_only() {
  if [ "$root_was_read_only" -eq 1 ]; then
    sync
    mount -o remount,ro / || true
    root_was_read_only=0
  fi
}
trap restore_root_read_only EXIT HUP INT TERM
case ",$(awk '$2 == "/" { print $4; exit }' /proc/mounts)," in
  *,ro,*)
    mount -o remount,rw /
    root_was_read_only=1
    ;;
esac
for unit in $UNITS; do
  if [ -f "/etc/systemd/system/$unit" ] && cmp -s "/etc/systemd/system/$unit" "/data/share/usr/lib/systemd/system/$unit"; then
    systemctl disable "$unit" 2>/dev/null || true
    rm -f "/etc/systemd/system/$unit"
  fi
done
restore_root_read_only
trap - EXIT HUP INT TERM
systemctl daemon-reload 2>/dev/null || true
exit 0
