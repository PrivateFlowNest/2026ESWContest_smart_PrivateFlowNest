# HomeMind 7-inch UI settings: /data/share/homemind/config/ui.env (conffile; edit on the device,
# then: systemctl restart homemind-ui). KEY=VALUE per line, no spaces around '=', no shell syntax.
# On Atlas, homemind-ui-atlas.sh copies the known keys into the Atlas app's own ui.env
# (/data/profiles/0/appdata/com.atlas.app.homemind_ui/home) at every start of homemind-ui.service.
#
# Never put the MQTT password here. HOMEMIND_MQTT_PASSWORD_FILE names the file created on the
# device (bash deploy/set-mqtt-password.sh rpi5-01: 0640 root:network); the Atlas app gets a 0400
# copy of it and reads its first line. A HOMEMIND_MQTT_PASSWORD key (or any other *PASSWORD* key)
# is refused.

# Pi4 broker, authenticated listener (same as broker.host/port in rpi5-01.json).
HOMEMIND_PI4_HOST=BROKER_HOST
HOMEMIND_MQTT_TCP_PORT=1884
HOMEMIND_MQTT_USERNAME=NODE-RPI5-01
HOMEMIND_MQTT_PASSWORD_FILE=/data/share/homemind/secrets/mqtt-password

# Camera page: live video from the vision service on NODE-RPI5-02 over the home router (newest JPEG only,
# nothing stored; its preview.allowed_clients must hold this Pi's address 10.10.10.3).
HOMEMIND_CAMERA_PREVIEW_URL=http://10.10.10.4:8091

# client_id in state requests, ui actions and pfn/v1/ai/voice/listen.
HOMEMIND_CLIENT_ID=homemind-ui-7inch
# Draw exactly 1024x600 (7-inch display) and hide scroll bars.
HOMEMIND_KIOSK=true
# As an Atlas app the UI keeps the top and bottom 6 % of the screen free: a tap in the bottom
# edge zone closes the app (Atlas edge swipe). Uncomment to turn that off.
#HOMEMIND_EDGE_GUARD=false
