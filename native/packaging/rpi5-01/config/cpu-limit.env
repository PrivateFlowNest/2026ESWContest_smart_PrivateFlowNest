# homemind-cpu-limit.service: CPU clock cap in kHz for every core (conffile; edit on the device).
# 1800000 = 1.8 GHz: no undervoltage on a 5 V 3 A supply with EXAONE on four cores (real Pi5-01, 2026-10-25).
# Empty = full 2.4 GHz, only with the official 5.1 V 5 A supply. Apply: systemctl restart homemind-cpu-limit
HM_CPU_MAX_KHZ=1800000
