# whisper-server settings for homemind-whisper.service (conffile). The model is copied by
# deploy/rpi5/install-rpi5.sh (SHA-256 checked against docs/handoff/MODEL_MANIFEST.md).
HM_WHISPER_MODEL=/data/share/homemind/models/ggml-whisper-small-homemind-lora-v4-q5_0.bin
HM_WHISPER_THREADS=4
# Extra whisper-server options. -ac 512 (audio context ~10 s, longer than vad.max_ms 8 s): 6.1 s instead of 12 s per
# command on the real Pi5-02 with the same transcripts (deploy/NODE-RPI5-02/stt-bench.sh, 2026-10-23).
HM_WHISPER_EXTRA_ARGS="-ac 512"
