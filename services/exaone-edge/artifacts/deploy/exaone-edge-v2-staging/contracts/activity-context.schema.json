{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/activity-context.schema.json",
  "title": "HomeMind Sanitized Activity Context",
  "description": "Privacy-minimized context passed to EXAONE. Raw audio, images, coordinates, and identity are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "presence_zone",
    "activity",
    "audio_context",
    "quiet_required",
    "confidence"
  ],
  "properties": {
    "presence_zone": {
      "enum": [
        "BED",
        "DESK",
        "BATHROOM",
        "ENTRANCE",
        "COMMON",
        "OUTDOOR",
        "UNKNOWN"
      ]
    },
    "activity": {
      "enum": [
        "RESTING",
        "SLEEPING",
        "STUDYING",
        "WORKING",
        "MEETING",
        "BATHROOM_USE",
        "ENTERING",
        "LEAVING",
        "GENERAL_ACTIVITY",
        "UNKNOWN"
      ]
    },
    "audio_context": {
      "enum": [
        "QUIET",
        "SELF_TALK",
        "TV_MEDIA",
        "ZOOM_SPEAKER",
        "ZOOM_HEADPHONES",
        "IN_PERSON_MEETING",
        "UNKNOWN"
      ]
    },
    "quiet_required": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
