# aarch64 (QEMU) functional check of the .pte with the official executorch 1.3.1 aarch64 wheel.
#   docker buildx build --platform linux/arm64 -f Dockerfile.aarch64-pycheck -t homemind-et-pycheck:arm64 --load .
#   docker run --rm --platform linux/arm64 -v <pte dir>:/m:ro -v <work dir>:/w homemind-et-pycheck:arm64 \
#     python /w/pte_greedy_check.py --pte /m/model.pte --prompt-json /w/prompt.json --out /w/aarch64.json
# Functional only: QEMU timings are not device latency.
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /py \
 && /py/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch==2.12.0" \
 && /py/bin/pip install --no-cache-dir --no-deps "executorch==1.3.1" \
 && /py/bin/pip install --no-cache-dir "numpy>=2" flatbuffers packaging typing-extensions ruamel.yaml pyyaml tabulate
ENV PATH=/py/bin:$PATH
