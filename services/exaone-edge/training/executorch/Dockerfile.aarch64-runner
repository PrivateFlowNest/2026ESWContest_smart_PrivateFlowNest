# Cross-build the ExecuTorch v1.3.1 LLM runner (llama_main: XNNPACK + custom sdpa/kv-cache ops +
# quantized kernels + HF tokenizer) for aarch64 / Raspberry Pi 5 (Cortex-A76), the same way
# native/arm64-tools/Dockerfile builds llama.cpp: Ubuntu 24.04 (glibc 2.39) + g++-aarch64-linux-gnu.
# Sources come from the official GitHub repo at the release tag; torch (CPU, x86) is only needed
# for torchgen during kernel-registration codegen.
#
#   docker buildx build -f services/exaone-edge/training/executorch/Dockerfile.aarch64-runner \
#     --output type=local,dest=native/.deps/executorch/aarch64 services/exaone-edge/training/executorch
FROM ubuntu:24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    cmake ninja-build make git ca-certificates g++ gcc g++-aarch64-linux-gnu gcc-aarch64-linux-gnu file \
    python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /py && /py/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.12.0+cpu" \
 && /py/bin/pip install --no-cache-dir pyyaml ruamel.yaml typing-extensions
ARG ET_TAG=v1.3.1
RUN git clone --depth 1 --branch ${ET_TAG} https://github.com/pytorch/executorch.git /src/executorch \
 && cd /src/executorch && git submodule update --init --recursive --depth 1
RUN printf '%s\n' \
  'set(CMAKE_SYSTEM_NAME Linux)' \
  'set(CMAKE_SYSTEM_PROCESSOR aarch64)' \
  'set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)' \
  'set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)' \
  'set(CMAKE_C_FLAGS_INIT "-march=armv8.2-a+dotprod+fp16 -mtune=cortex-a76")' \
  'set(CMAKE_CXX_FLAGS_INIT "-march=armv8.2-a+dotprod+fp16 -mtune=cortex-a76")' \
  'set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)' \
  'set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)' \
  'set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)' \
  'set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)' > /toolchain.cmake
ENV PATH=/py/bin:$PATH
ARG JOBS=
WORKDIR /src/executorch
RUN cmake --preset llm -G Ninja -DCMAKE_TOOLCHAIN_FILE=/toolchain.cmake -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/src/executorch/cmake-out -DEXECUTORCH_BUILD_EXTENSION_MODULE=ON \
      -DPYTHON_EXECUTABLE=/py/bin/python \
 && cmake --build cmake-out -j"${JOBS:-$(nproc)}" --target install --config Release
RUN cmake -G Ninja -DCMAKE_TOOLCHAIN_FILE=/toolchain.cmake -DCMAKE_INSTALL_PREFIX=/src/executorch/cmake-out \
      -DCMAKE_PREFIX_PATH=/src/executorch/cmake-out -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release \
      -DPYTHON_EXECUTABLE=/py/bin/python \
      -B cmake-out/examples/models/llama examples/models/llama \
 && cmake --build cmake-out/examples/models/llama -j"${JOBS:-$(nproc)}" --config Release \
 && mkdir -p /out/bin \
 && cp cmake-out/examples/models/llama/llama_main /out/bin/
# bundle the non-system shared libs llama_main needs (libllama_runner.so, ...) with RUNPATH=$ORIGIN
COPY bundle_libs.sh /bundle_libs.sh
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends patchelf \
 && rm -rf /var/lib/apt/lists/* \
 && sh /bundle_libs.sh /out/bin cmake-out \
 && file /out/bin/* > /out/FILES.txt \
 && (cd /out/bin && for f in *; do echo "== $f"; aarch64-linux-gnu-readelf -d "$f" | grep -E "NEEDED|RUNPATH"; done) >> /out/FILES.txt \
 && git rev-parse HEAD > /out/EXECUTORCH_COMMIT.txt
FROM scratch
COPY --from=build /out/ /
