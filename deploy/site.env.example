# Site values for this home/router. Copy to deploy/site.env (gitignored) and fill in after the router is set up.
# Addresses only — never passwords, tokens or Wi-Fi keys (those live on the devices / in firmware/include/secrets.h).
# With site.env filled, every install script can run without arguments, e.g.  bash deploy/NODE-RPI5-02/install.sh
SSH_USER=root
RPI4_01_HOST=        # NODE-RPI4-01 backend = MQTT broker (fixed IP via DHCP reservation)
RPI5_01_HOST=        # NODE-RPI5-01 7-inch UI + EXAONE
RPI5_02_HOST=        # NODE-RPI5-02 perception
BROKER_PORT=1884     # authenticated listener (1883 = anonymous direct-cable development network)
