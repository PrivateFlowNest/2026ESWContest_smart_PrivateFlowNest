# Mobile API 0.3 (core path). Values for the development network; never put a password here.
HOMEMIND_MQTT_ENABLED=false
HOMEMIND_MQTT_HOST=127.0.0.1
HOMEMIND_MQTT_PORT=1884
HOMEMIND_MQTT_USERNAME=homemind-mobile-api
# Path to a file whose first line is the MQTT password (create it on the machine, mode 0600)
HOMEMIND_MQTT_PASSWORD_FILE=
HOMEMIND_MQTT_CLIENT_ID=homemind-mobile-api
# Must be an origin "ui" source in contracts/pfn.v1/task-policy.json: NODE-RPI4-01 or NODE-RPI5-01
HOMEMIND_SOURCE_NODE_ID=NODE-RPI4-01
# Optional registry path (default: <repo>/contracts/pfn.v1/device-registry.json)
HOMEMIND_DEVICE_REGISTRY=
# Comma-separated browser origins for CORS (empty = no CORS; the Android app does not need it)
HOMEMIND_CORS_ORIGINS=
# QR pairing + bearer tokens (app/auth.py). Tokens are stored hashed in <data dir>/tokens.json (0600).
# Default data dir: ~/.homemind/mobile-api. The pairing secret file is created there when missing; never put the value here.
HOMEMIND_DATA_DIR=
HOMEMIND_PAIRING_SECRET_FILE=
# URL the phone uses to reach this API (QR base_url), e.g. http://<this machine's LAN address>:8000
HOMEMIND_PUBLIC_BASE_URL=
HOMEMIND_DEVICE_ID=NODE-RPI4-01
HOMEMIND_DEVICE_NAME=
HOMEMIND_PAIRING_CODE_TTL_S=600
HOMEMIND_PAIRING_MAX_FAILURES_PER_CLIENT=5
HOMEMIND_PAIRING_MAX_FAILURES_GLOBAL=20
HOMEMIND_PAIRING_FAILURE_WINDOW_S=300
