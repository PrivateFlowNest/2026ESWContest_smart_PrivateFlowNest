[Unit]
Description=HomeMind Hardware Mobile API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homemind
WorkingDirectory=/opt/homemind-application/backend
EnvironmentFile=-/etc/homemind/mobile-api.env
# PC/dev reference only (the device runs the C++ native/services/homemind-mobile-api). Bearer tokens are required;
# plain HTTP, so keep it on localhost / the dev network.
ExecStart=/opt/homemind-application/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
