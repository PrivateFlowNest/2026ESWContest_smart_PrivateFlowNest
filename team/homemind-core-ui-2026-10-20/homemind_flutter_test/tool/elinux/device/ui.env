# HomeMind 7-inch UI settings: /data/share/homemind/config/ui.env (conffile; edit on the device).
# Read by /data/share/homemind/ui/homemind-ui-launch.sh: KEY=VALUE per line, no spaces around '=',
# no shell syntax. Unknown keys stop the launcher.
#
# Never put the MQTT password here. HOMEMIND_MQTT_PASSWORD_FILE names the file created on the
# device (deploy/rpi5/install-rpi5.sh step 5: 0640 root:network); the UI reads its first line.
# A HOMEMIND_MQTT_PASSWORD key (or any other *PASSWORD* key) is refused.

# Pi4 broker, authenticated listener (same as broker.host/port in rpi5-01.json).
HOMEMIND_PI4_HOST=BROKER_HOST
HOMEMIND_MQTT_TCP_PORT=1884
HOMEMIND_MQTT_USERNAME=NODE-RPI5-01
HOMEMIND_MQTT_PASSWORD_FILE=/data/share/homemind/secrets/mqtt-password

# client_id in state requests, ui actions and pfn/v1/ai/voice/listen.
HOMEMIND_CLIENT_ID=homemind-ui-7inch
# Draw exactly 1024x600 (7-inch display) and hide scroll bars.
HOMEMIND_KIOSK=true
