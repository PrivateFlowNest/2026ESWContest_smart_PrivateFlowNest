  "notes": [
    "AI vocabulary (rpi5-internal/task-proposal.schema.json) to core commands. Used by the NODE-RPI5-02 voice parser and the NODE-RPI5-01 EXAONE guard to build device_control task requests or scenario intents.",
    "enabled=false entries are closed (fail-closed): the AI side answers UNSUPPORTED and sends nothing to core.",
    "position_ref resolves to device-registry positions[open|closed]. parameter_from copies a task-proposal parameter into the command parameter.",
    "LED single colour: set_switch is the power state (steady red); set_color pattern=blink is the quiet overlay; pattern=steady clears the overlay and shows the power state again."
  ],
  "zone_map": {
    "BED": "bed",
    "DESK": "desk",
    "BATHROOM": "bathroom",
