{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/pfn-v1-perception.schema.json",
  "title": "HomeMind NODE-RPI5-02 observation without answer labels",
  "description": "Published by NODE-RPI5-02 only. Results only: no frames, audio, transcripts, coordinates or identities. zone uses device-registry zones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "trace_id", "source_node_id",
    "observation_type", "zone", "confidence", "attributes", "observed_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "pfn.v1" },
    "event_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "source_node_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_device_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "observation_type": { "enum": ["FIGURE_PRESENCE", "ACTIVITY_CONTEXT", "PARTIAL_INTENT_HINT"] },
    "zone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "attributes": { "type": "object" },
    "observed_at_ms": { "type": "integer", "minimum": 0 },
    "simulated": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "observation_type": { "const": "FIGURE_PRESENCE" } } },
      "then": {
        "required": ["source_device_id"],
        "properties": {
          "source_device_id": { "enum": ["CAM-INDOOR-01", "CAM-OUTDOOR-01"] },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["present", "figure_count", "model_version"],
            "properties": {
              "present": { "type": "boolean" },
              "figure_count": { "type": "integer", "minimum": 0, "maximum": 20 },
              "model_version": { "type": "string", "minLength": 1, "maxLength": 64 },
              "frame_age_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "observation_type": { "const": "ACTIVITY_CONTEXT" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "activity", "audio_context", "quiet_required", "transition",
              "evidence", "valid_until_ms", "model_version"
            ],
            "properties": {
              "activity": {
                "enum": [
                  "RESTING", "SLEEPING", "STUDYING", "WORKING", "MEETING", "BATHROOM_USE",
                  "ENTERING", "LEAVING", "GENERAL_ACTIVITY", "UNKNOWN"
                ]
              },
              "audio_context": {
                "enum": [
                  "QUIET", "SELF_TALK", "TV_MEDIA", "ZOOM_SPEAKER", "ZOOM_HEADPHONES",
                  "IN_PERSON_MEETING", "UNKNOWN"
                ]
              },
              "quiet_required": { "type": "boolean" },
              "transition": { "enum": ["ACTIVATED", "UPDATED", "DEACTIVATED", "UNCHANGED"] },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 64 }
              },
              "valid_until_ms": { "type": "integer", "minimum": 0 },
              "model_version": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "observation_type": { "const": "PARTIAL_INTENT_HINT" } } },
      "then": {
        "required": ["source_device_id"],
        "properties": {
          "source_device_id": { "const": "MIC-INDOOR-01" },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent", "result", "candidate_devices", "requires_confirmation",
              "execution_allowed", "model_version"
            ],
            "properties": {
              "intent": {
                "enum": [
                  "CLIMATE_COMFORT", "LIGHTING", "VENTILATION", "MEDIA", "ACCESS",
                  "LAUNDRY", "CLEANING", "QUIET_ENVIRONMENT", "NO_ACTION"
                ]
              },
              "result": { "enum": ["DETECTED", "INSUFFICIENT_EVIDENCE", "SUPPRESSED"] },
              "candidate_devices": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$", "maxLength": 64 }
              },
              "requires_confirmation": { "type": "boolean" },
              "execution_allowed": { "const": false },
              "model_version": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        }
      }
    }
  ]
}
