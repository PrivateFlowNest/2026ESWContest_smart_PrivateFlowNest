{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/pfn-v1-ai-action-map.schema.json",
  "title": "HomeMind AI vocabulary to core command map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_version", "notes", "zone_map", "devices", "actions"],
  "properties": {
    "schema_version": { "const": "pfn.v1" },
    "map_version": { "type": "integer", "minimum": 1 },
    "notes": { "type": "array", "items": { "type": "string" } },
    "zone_map": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
    },
    "devices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "enabled"],
        "properties": {
          "device_id": { "type": ["string", "null"], "maxLength": 64 },
          "number_device_id": { "type": "string", "maxLength": 64 },
          "enabled": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ai_device", "ai_action", "kind", "enabled"],
        "properties": {
          "ai_device": { "type": "string", "minLength": 1, "maxLength": 64 },
          "ai_action": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "enum": ["device_control", "scenario", "query", "unsupported"] },
          "command": { "enum": ["set_switch", "set_color", "set_level", "set_position", "set_number"] },
          "target": { "enum": ["device_id", "number_device_id"] },
          "parameters": { "type": "object" },
          "position_ref": { "enum": ["open", "closed"] },
          "parameter_from": { "type": "object", "additionalProperties": { "type": "string" } },
          "intent": { "type": "string", "minLength": 1, "maxLength": 64 },
          "enabled": { "type": "boolean" },
          "pending_decision": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
