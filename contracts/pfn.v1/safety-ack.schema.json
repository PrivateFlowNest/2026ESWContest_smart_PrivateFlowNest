{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/pfn-v1-safety-ack.schema.json",
  "title": "HomeMind user acknowledgement of a P0 alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "trace_id", "alert_id", "client_id",
    "action", "sent_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "pfn.v1" },
    "event_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "alert_id": { "type": "string", "format": "uuid" },
    "client_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "action": { "enum": ["acknowledge", "dismiss_test"] },
    "sent_at_ms": { "type": "integer", "minimum": 0 }
  }
}
