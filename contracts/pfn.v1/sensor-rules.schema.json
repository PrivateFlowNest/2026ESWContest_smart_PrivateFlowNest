{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/sensor-rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules_version", "reject_unknown_readings", "readings"],
  "properties": {
    "schema_version": { "const": "pfn.v1" },
    "rules_version": { "type": "integer", "minimum": 1 },
    "reject_unknown_readings": { "type": "boolean" },
    "readings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "allowed_source_device_ids"],
        "properties": {
          "type": { "enum": ["number", "integer", "boolean", "string"] },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "enum": { "type": "array", "minItems": 1 },
          "allowed_source_device_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
        }
      }
    }
  }
}
