{
  "schema_version": "pfn.v1",
  "rules_version": 2,
  "reject_unknown_readings": true,
  "readings": {
    "sound_level_db": { "type": "number", "minimum": 0, "maximum": 120, "allowed_source_device_ids": ["MIC-INDOOR-01"] },
    "x_home_active": { "type": "boolean", "allowed_source_device_ids": ["SENSOR-HOME-X-01"] },
    "y_home_active": { "type": "boolean", "allowed_source_device_ids": ["SENSOR-HOME-Y-01"] },
    "fan_level_percent": { "type": "number", "minimum": 0, "maximum": 100, "allowed_source_device_ids": ["FAN-01"] },
    "door_position_degrees": { "type": "number", "minimum": 0, "maximum": 180, "allowed_source_device_ids": ["SERVO-DOOR-01"] },
    "window_position_degrees": { "type": "number", "minimum": 0, "maximum": 180, "allowed_source_device_ids": ["SERVO-WINDOW-01"] },
    "bed_curtain_position_degrees": { "type": "number", "minimum": 0, "maximum": 180, "allowed_source_device_ids": ["SERVO-BED-CURTAIN-01"] },
    "light_on": { "type": "boolean", "allowed_source_device_ids": ["LED-WASHER-01", "LED-AIRCON-01", "LED-TV-01", "LED-LAPTOP-01", "LED-LIVING-01", "LED-GUIDE-01"] },
    "light_pattern": { "type": "string", "enum": ["off", "steady", "blink"], "allowed_source_device_ids": ["LED-WASHER-01", "LED-AIRCON-01", "LED-TV-01", "LED-LAPTOP-01", "LED-LIVING-01"] },
    "display_value": { "type": "integer", "minimum": 0, "maximum": 9999, "allowed_source_device_ids": ["FND-WASHER-01", "FND-AIRCON-01", "FND-TV-01"] }
  }
}
