{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/pfn-v1-task-request.schema.json",
  "title": "HomeMind Pi5 to Pi4 task request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "trace_id", "task_id", "source_node_id",
    "intent", "target_device", "priority", "safety_level", "interruptible",
    "resume_policy", "confidence", "parameters", "requested_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "pfn.v1" },
    "event_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "source_node_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target_device": { "type": "string", "minLength": 1, "maxLength": 64 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "safety_level": { "enum": ["normal", "caution", "critical"] },
    "interruptible": { "type": "boolean" },
    "resume_policy": { "enum": ["never", "manual", "when_context_returns", "automatic"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "parameters": { "type": "object" },
    "requested_at_ms": { "type": "integer", "minimum": 0 }
  }
}
