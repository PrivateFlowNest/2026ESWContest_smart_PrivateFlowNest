{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homemind.local/contracts/context-activity-event.schema.json",
  "title": "HomeMind Fused Activity Context Event",
  "description": "Privacy-minimized context proposal emitted by Pi 5. This event cannot command a device; Pi 4 remains the control authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "trace_id",
    "timestamp",
    "source",
    "source_node_id",
    "event_type",
    "context_type",
    "presence_zone",
    "activity",
    "quiet_required",
    "confidence",
    "evidence",
    "transition",
    "valid_until",
    "model_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "const": "pi5.context-fusion" },
    "source_node_id": { "const": "NODE-RPI5-02" },
    "event_type": { "const": "ACTIVITY_CONTEXT" },
    "context_type": {
      "enum": [
        "QUIET",
        "SELF_TALK",
        "TV_MEDIA",
        "ZOOM_SPEAKER",
        "ZOOM_HEADPHONES",
        "IN_PERSON_MEETING",
        "UNKNOWN"
      ]
    },
    "presence_zone": {
      "enum": [
        "BED",
        "DESK",
        "BATHROOM",
        "ENTRANCE",
        "COMMON",
        "OUTDOOR",
        "UNKNOWN"
      ]
    },
    "activity": {
      "enum": [
        "RESTING",
        "SLEEPING",
        "STUDYING",
        "WORKING",
        "MEETING",
        "BATHROOM_USE",
        "ENTERING",
        "LEAVING",
        "GENERAL_ACTIVITY",
        "UNKNOWN"
      ]
    },
    "quiet_required": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "transition": {
      "enum": ["ACTIVATED", "UPDATED", "DEACTIVATED", "UNCHANGED"]
    },
    "valid_until": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 }
  }
}
